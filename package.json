{
  "name": "giti-rss-registry",
  "version": "1.0.0",
  "description": "Curated global news feed registry for Giti",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitinamalive/giti-rss-registry.git"
  },
  "scripts": {
    "validate": "npx tsx scripts/validate.ts && npx tsx scripts/validate-schema.ts",
    "validate:schema": "npx tsx scripts/validate-schema.ts",
    "build": "npx tsx scripts/build-artifacts.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "rss",
    "news",
    "registry",
    "giti"
  ],
  "author": "Giti Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.1.1",
    "ajv": "^8.20.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  }
}
