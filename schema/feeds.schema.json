{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema/feeds.schema.json",
  "title": "Giti RSS Registry",
  "description": "JSON Schema for the registry payload (data/feeds.json). Mirrors src/types.ts; validated by scripts/validate-schema.ts.",
  "type": "object",
  "required": ["generatedAt", "source", "stats", "warnings", "feeds"],
  "properties": {
    "generatedAt": { "type": "string" },
    "source": { "type": "string" },
    "stats": {
      "type": "object",
      "required": ["feeds", "duplicateIds", "duplicateUrls"],
      "properties": {
        "feeds": { "type": "integer", "minimum": 0 },
        "duplicateIds": { "type": "integer", "minimum": 0 },
        "duplicateUrls": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "object",
      "properties": {
        "duplicateIds": { "type": "array", "items": { "type": "string" } },
        "duplicateUrls": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "feeds": {
      "type": "array",
      "items": { "$ref": "#/$defs/FeedEntry" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "FeedEntry": {
      "type": "object",
      "required": ["id", "name", "publisher", "url", "language", "countries", "category"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque, immutable identifier (publisher slug + 8-hex sha1 of normalized URL). Existing IDs are never regenerated."
        },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://.+" },
        "homepage": { "type": "string" },
        "language": { "$ref": "#/$defs/LanguageCode" },
        "countries": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "region": { "type": "string" },
        "category": { "$ref": "#/$defs/FeedCategory" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "perspective": { "$ref": "#/$defs/Perspective" },
        "mediaType": { "$ref": "#/$defs/MediaType" },
        "format": { "$ref": "#/$defs/FeedFormat" },
        "official": { "type": "boolean" },
        "active": { "type": "boolean" },
        "lastCheckedAt": { "type": "string" },
        "lastItemPublishedAt": { "type": "string" },
        "healthScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "notes": { "type": "string" },
        "description": { "type": "string" },
        "coverageType": { "$ref": "#/$defs/CoverageType" },
        "publisherCountries": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "alwaysSchedule": { "type": "boolean" },
        "sourceAttribution": { "type": "string" },
        "license": { "type": "string" }
      },
      "additionalProperties": false
    },
    "FeedCategory": {
      "type": "string",
      "enum": ["world", "us", "europe", "technology", "ai", "space", "finance", "science", "climate", "politics", "investigative", "sports", "entertainment", "health", "culture"]
    },
    "Perspective": {
      "type": "string",
      "enum": ["independent", "state-affiliated", "independent-exile", "regional", "state-monitor", "aggregator"]
    },
    "MediaType": {
      "type": "string",
      "enum": ["print", "tv", "radio", "digital", "wire", "aggregator", "broadcast"]
    },
    "FeedFormat": {
      "type": "string",
      "enum": ["rss", "atom", "jsonfeed", "rdf"]
    },
    "LanguageCode": {
      "type": "string",
      "enum": ["aa", "ab", "ae", "af", "ak", "am", "an", "ar", "as", "av", "ay", "az", "ba", "be", "bg", "bh", "bi", "bm", "bn", "bo", "br", "bs", "ca", "ce", "ch", "co", "cr", "cs", "cu", "cv", "cy", "da", "de", "dv", "dz", "ee", "el", "en", "eo", "es", "et", "eu", "fa", "ff", "fi", "fj", "fo", "fr", "fy", "ga", "gd", "gl", "gn", "gu", "gv", "ha", "he", "hi", "ho", "hr", "ht", "hu", "hy", "hz", "ia", "id", "ie", "ig", "ii", "ik", "io", "is", "it", "iu", "ja", "jv", "ka", "kg", "ki", "kj", "kk", "kl", "km", "kn", "ko", "kr", "ks", "ku", "kv", "kw", "ky", "la", "lb", "lg", "li", "ln", "lo", "lt", "lu", "lv", "mg", "mh", "mi", "mk", "ml", "mn", "mr", "ms", "mt", "my", "na", "nb", "nd", "ne", "ng", "nl", "nn", "no", "nr", "nv", "ny", "oc", "oj", "om", "or", "os", "pa", "pi", "pl", "ps", "pt", "qu", "rm", "rn", "ro", "ru", "rw", "sa", "sc", "sd", "se", "sg", "si", "sk", "sl", "sm", "sn", "so", "sq", "sr", "ss", "st", "su", "sv", "sw", "ta", "te", "tg", "th", "ti", "tk", "tl", "tn", "to", "tr", "ts", "tt", "tw", "ty", "ug", "uk", "ur", "uz", "ve", "vi", "vo", "wa", "wo", "xh", "yi", "yo", "za", "zh", "zu"]
    },
    "CoverageType": {
      "type": "string",
      "enum": ["global", "international", "regional", "national", "single-country", "investigative", "aggregator", "health", "science", "sports", "entertainment", "culture"]
    }
  }
}
